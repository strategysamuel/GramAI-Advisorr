# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLOUD_PROJECT_ID: The Google Cloud Project ID for this application.
GOOGLE_CLOUD_PROJECT_ID="gramai-advisor"

# Cloud Run Microservices URLs
VITE_CROP_AGENT_URL=
VITE_LAND_AGENT_URL=
VITE_FINANCE_AGENT_URL=
VITE_SCHEME_AGENT_URL=
VITE_OPTIMIZER_URL=
VITE_ORCHESTRATOR_URL=
VITE_DOCUMENT_AGENT_URL=
